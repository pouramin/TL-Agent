{
  "manifest_version": 3,
  "name": "TL Studio Claude Web Bridge (Page Context)",
  "version": "0.6.1",
  "description": "Inference-only transport between TL Studio and the Claude Web session already signed in to this Chrome profile.",
  "key": "",
  "permissions": ["scripting"],
  "host_permissions": ["https://claude.ai/*"],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "background": { "service_worker": "background.js" }
}
