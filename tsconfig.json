{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["DOM", "ES2020"],
    "rootDir": "cmd/launcher/ui",
    "outDir": "cmd/launcher/web",
    "strict": false,
    "skipLibCheck": true,
    "removeComments": false,
    "sourceMap": false,
    "noEmitOnError": true
  },
  "include": ["cmd/launcher/ui/**/*.ts", "cmd/launcher/ui/**/*.d.ts"]
}
